# Адрес бэкенда для разработки: скопируйте файл в .env.
# Для Expo Go на телефоне localhost недоступен: нужен IP компьютера в локальной сети.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Адрес стенда в .env не ставим: пробитый чек уйдёт в его базу. В сборки для
# телефона адрес передаётся переменной окружения при сборке.
